<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en"><generator uri="https://jekyllrb.com/" version="4.4.1">Jekyll</generator><link href="https://andferrari.github.io/feed.xml" rel="self" type="application/atom+xml"/><link href="https://andferrari.github.io/" rel="alternate" type="text/html" hreflang="en"/><updated>2026-10-25T19:56:52+00:00</updated><id>https://andferrari.github.io/feed.xml</id><title type="html">blank</title><subtitle>A simple, whitespace theme for academics. Based on [*folio](https://github.com/bogoli/-folio) design. </subtitle><entry><title type="html">Nice airport traffic ✈️</title><link href="https://andferrari.github.io/blog/2026/airport_traffic/" rel="alternate" type="text/html" title="Nice airport traffic ✈️"/><published>2026-10-10T00:00:00+00:00</published><updated>2026-10-10T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2026/airport_traffic</id><content type="html" xml:base="https://andferrari.github.io/blog/2026/airport_traffic/"><![CDATA[<p><img src="/assets/img/posts/airport_traffic.png" alt="sigmoid_fit" width="500"/></p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">Dates</span><span class="x">,</span> <span class="n">CairoMakie</span>

<span class="k">function</span><span class="nf"> airport_pass</span><span class="x">()</span>
    <span class="n">tick_years</span> <span class="o">=</span> <span class="kt">Date</span><span class="o">.</span><span class="x">(</span><span class="mi">2012</span><span class="o">:</span><span class="mi">2023</span><span class="x">)</span>
    <span class="n">DateTick</span> <span class="o">=</span> <span class="n">Dates</span><span class="o">.</span><span class="n">format</span><span class="o">.</span><span class="x">(</span><span class="n">tick_years</span><span class="x">,</span> <span class="s">"yyyy"</span><span class="x">)</span>
        
    <span class="n">traf_nice</span> <span class="o">=</span> <span class="x">[</span><span class="mi">11_068_465</span><span class="x">,</span> <span class="mi">11_432_028</span><span class="x">,</span> <span class="mi">11_535_824</span><span class="x">,</span> <span class="mi">11_889_288</span><span class="x">,</span>
        <span class="mi">12_300_643</span><span class="x">,</span> <span class="mi">13_172_535</span><span class="x">,</span> <span class="mi">13_719_099</span><span class="x">,</span> <span class="mi">14_356_977</span><span class="x">,</span>
        <span class="mi">4_525_639</span><span class="x">,</span> <span class="mi">6_452_074</span><span class="x">,</span> <span class="mi">12_008_810</span><span class="x">,</span> <span class="mi">14_082_130</span><span class="x">]</span> 
        
    <span class="n">traf_nice</span> <span class="o">=</span> <span class="x">[</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2012</span><span class="x">)</span> <span class="mi">11_068_465</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2013</span><span class="x">)</span> <span class="mi">11_432_028</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2014</span><span class="x">)</span> <span class="mi">11_660_208</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2015</span><span class="x">)</span> <span class="mi">12_016_730</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2016</span><span class="x">)</span> <span class="mi">12_427_427</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2017</span><span class="x">)</span> <span class="mi">13_304_782</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2018</span><span class="x">)</span> <span class="mi">13_850_561</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2019</span><span class="x">)</span> <span class="mi">14_485_423</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2020</span><span class="x">)</span> <span class="mi">4_580_459</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2021</span><span class="x">)</span> <span class="mi">6_540_424</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2022</span><span class="x">)</span> <span class="mi">12_119_043</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2023</span><span class="x">)</span> <span class="mi">14_189_965</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2024</span><span class="x">)</span> <span class="mi">14_763_753</span><span class="x">;</span>
    	<span class="kt">Date</span><span class="x">(</span><span class="mi">2025</span><span class="x">)</span> <span class="mi">15_229_664</span><span class="x">;</span>	
    	<span class="x">]</span>
        
    <span class="n">DateTick</span> <span class="o">=</span> <span class="n">Dates</span><span class="o">.</span><span class="n">format</span><span class="o">.</span><span class="x">(</span><span class="n">traf_nice</span><span class="x">[</span><span class="o">:</span><span class="x">,</span><span class="mi">1</span><span class="x">],</span> <span class="s">"yyyy"</span><span class="x">)</span>
        
    <span class="n">fig</span> <span class="o">=</span> <span class="n">Figure</span><span class="x">()</span>
    <span class="n">ax1</span> <span class="o">=</span> <span class="n">Axis</span><span class="x">(</span><span class="n">fig</span><span class="x">[</span><span class="mi">1</span><span class="x">,</span><span class="mi">1</span><span class="x">])</span>
    <span class="n">scatterlines!</span><span class="x">(</span><span class="n">ax1</span><span class="x">,</span> <span class="mi">1</span><span class="o">:</span><span class="n">length</span><span class="x">(</span><span class="n">DateTick</span><span class="x">),</span> <span class="n">traf_nice</span><span class="x">[</span><span class="o">:</span><span class="x">,</span><span class="mi">2</span><span class="x">],</span> <span class="n">linewidth</span><span class="o">=</span><span class="mi">2</span><span class="x">)</span>
    <span class="n">ax1</span><span class="o">.</span><span class="n">xticks</span> <span class="o">=</span> <span class="x">(</span><span class="mi">1</span><span class="o">:</span><span class="n">length</span><span class="x">(</span><span class="n">DateTick</span><span class="x">),</span> <span class="n">DateTick</span><span class="x">)</span>
    <span class="n">ax1</span><span class="o">.</span><span class="n">xticklabelrotation</span> <span class="o">=</span> <span class="mf">45.0</span>
    <span class="n">ax1</span><span class="o">.</span><span class="n">xlabel</span> <span class="o">=</span> <span class="s">"Year"</span>
    <span class="n">ax1</span><span class="o">.</span><span class="n">ylabel</span> <span class="o">=</span> <span class="s">"Number of passengers"</span>
    
    <span class="n">titlelayout</span> <span class="o">=</span> <span class="n">GridLayout</span><span class="x">(</span><span class="n">fig</span><span class="x">[</span><span class="mi">0</span><span class="x">,</span> <span class="mi">1</span><span class="x">],</span> <span class="n">halign</span> <span class="o">=</span> <span class="o">:</span><span class="n">left</span><span class="x">,</span> <span class="n">tellwidth</span> <span class="o">=</span> <span class="nb">false</span><span class="x">)</span>
    <span class="n">Label</span><span class="x">(</span><span class="n">titlelayout</span><span class="x">[</span><span class="mi">1</span><span class="x">,</span> <span class="mi">1</span><span class="x">],</span> <span class="s">"Air traffic at Côte d'Azur airport"</span><span class="x">,</span> <span class="n">halign</span> <span class="o">=</span> <span class="o">:</span><span class="n">left</span><span class="x">,</span>  <span class="n">fontsize</span> <span class="o">=</span> <span class="mi">20</span><span class="x">)</span>
    <span class="n">Label</span><span class="x">(</span><span class="n">titlelayout</span><span class="x">[</span><span class="mi">2</span><span class="x">,</span> <span class="mi">1</span><span class="x">],</span> <span class="s">"https://societe.nice.aeroport.fr/presse-media/trafic-annuel"</span><span class="x">,</span> <span class="n">halign</span> <span class="o">=</span> <span class="o">:</span><span class="n">left</span><span class="x">,</span> <span class="n">fontsize</span> <span class="o">=</span> <span class="mi">12</span><span class="x">)</span>
    
    <span class="n">fig</span>
<span class="k">end</span>

<span class="n">theplot</span> <span class="o">=</span> <span class="n">with_theme</span><span class="x">(</span><span class="n">airport_pass</span><span class="x">,</span> <span class="n">theme_light</span><span class="x">())</span>
<span class="n">save</span><span class="x">(</span><span class="s">"airport_traffic.png"</span><span class="x">,</span> <span class="n">theplot</span><span class="x">)</span>
</code></pre></div></div>]]></content><author><name></name></author><category term="julia"/><summary type="html"><![CDATA[passengers traffic vs years]]></summary></entry><entry><title type="html">wordcloud from bib 💻</title><link href="https://andferrari.github.io/blog/2024/wordcloud/" rel="alternate" type="text/html" title="wordcloud from bib 💻"/><published>2024-10-16T00:00:00+00:00</published><updated>2024-10-16T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2024/wordcloud</id><content type="html" xml:base="https://andferrari.github.io/blog/2024/wordcloud/"><![CDATA[<p>Create a wordcloud from <code class="language-plaintext highlighter-rouge">.bib</code> file</p> <p><img src="/assets/img/posts/wordcloud.png" alt="Wordcloud" width="400"/></p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">Bibliography</span><span class="x">,</span> <span class="n">WordCloud</span>

<span class="k">function</span><span class="nf"> all_words</span><span class="x">(</span><span class="n">bib_file</span><span class="x">)</span>	
	<span class="n">imported_bib</span> <span class="o">=</span> <span class="n">import_bibtex</span><span class="x">(</span><span class="n">bib_file</span><span class="x">)</span>
	<span class="n">words</span> <span class="o">=</span> <span class="s">""</span>
	<span class="k">for</span> <span class="n">ref</span> <span class="k">in</span> <span class="n">keys</span><span class="x">(</span><span class="n">imported_bib</span><span class="x">)</span>
		<span class="n">words</span> <span class="o">=</span> <span class="n">string</span><span class="x">(</span><span class="n">words</span><span class="x">,</span> <span class="n">lowercase</span><span class="x">(</span><span class="n">imported_bib</span><span class="x">[</span><span class="n">ref</span><span class="x">]</span><span class="o">.</span><span class="n">title</span><span class="x">),</span> <span class="s">" "</span><span class="x">)</span>
	<span class="k">end</span>
	<span class="n">words</span>
<span class="k">end</span>

<span class="n">path</span> <span class="o">=</span> <span class="s">"/Users/ferrari/Documents/Sites/andferrari.github.io/_bibliography/"</span>
<span class="n">words</span> <span class="o">=</span> <span class="n">all_words</span><span class="x">(</span><span class="n">path</span><span class="o">*</span><span class="s">"papers_af.bib"</span><span class="x">)</span>

<span class="n">cl_words</span> <span class="o">=</span> <span class="n">processtext</span><span class="x">(</span><span class="n">words</span><span class="x">,</span> <span class="n">maxnum</span> <span class="o">=</span> <span class="mi">200</span><span class="x">,</span> <span class="n">minlength</span> <span class="o">=</span> <span class="mi">4</span><span class="x">,</span> <span class="n">stopwords_extra</span> <span class="o">=</span> <span class="x">[</span><span class="s">"using"</span><span class="x">,</span> <span class="s">"application"</span><span class="x">])</span>

<span class="n">wc</span> <span class="o">=</span> <span class="n">wordcloud</span><span class="x">(</span><span class="n">cl_words</span><span class="x">,</span> 
		<span class="n">mask</span><span class="o">=</span><span class="n">shape</span><span class="x">(</span><span class="n">box</span><span class="x">,</span> <span class="mi">500</span> <span class="o">*</span> <span class="mi">2</span><span class="x">,</span> <span class="mi">350</span> <span class="o">*</span> <span class="mi">2</span><span class="x">,</span> <span class="n">cornerradius</span><span class="o">=</span><span class="mi">10</span> <span class="o">*</span> <span class="mi">2</span><span class="x">),</span> 
		<span class="n">fonts</span> <span class="o">=</span> <span class="s">"menlo"</span><span class="x">,</span> <span class="n">colors</span> <span class="o">=</span> <span class="o">:</span><span class="n">seaborn_dark</span><span class="x">)</span> 

<span class="n">generate!</span><span class="x">(</span><span class="n">wc</span><span class="x">)</span>
<span class="n">paint</span><span class="x">(</span><span class="n">wc</span><span class="x">,</span> <span class="s">"wordcloud.png"</span><span class="x">)</span>
</code></pre></div></div>]]></content><author><name></name></author><category term="julia"/><category term="fun"/><summary type="html"><![CDATA[Create a wordcloud from bib files in julia]]></summary></entry><entry><title type="html">Sigmoid fit 💻</title><link href="https://andferrari.github.io/blog/2021/sigmoid_fit/" rel="alternate" type="text/html" title="Sigmoid fit 💻"/><published>2021-09-09T00:00:00+00:00</published><updated>2021-09-09T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/sigmoid_fit</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/sigmoid_fit/"><![CDATA[<p>Inspired by the nice <a href="https://twitter.com/clcrozier/status/1251148890595708938?s=21">tweet</a> of Constance Crozier, here is the julia code to illustrate the fit of a sigmoid as a function of the number of samples.</p> <p><img src="/assets/img/posts/sigmoid_fit.gif" alt="sigmoid_fit"/></p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">Plots</span><span class="x">,</span> <span class="n">LsqFit</span>

<span class="nd">@.</span> <span class="n">σ</span><span class="x">(</span><span class="n">x</span><span class="x">,</span> <span class="n">θ</span><span class="x">)</span> <span class="o">=</span> <span class="n">θ</span><span class="x">[</span><span class="mi">1</span><span class="x">]</span><span class="o">/</span><span class="x">(</span><span class="mi">1</span> <span class="o">+</span> <span class="n">exp</span><span class="x">(</span><span class="o">-</span><span class="n">θ</span><span class="x">[</span><span class="mi">2</span><span class="x">]</span><span class="o">*</span><span class="n">x</span><span class="x">))</span>

<span class="n">x_plot</span> <span class="o">=</span> <span class="n">range</span><span class="x">(</span><span class="o">-</span><span class="mi">6</span><span class="x">,</span><span class="n">stop</span><span class="o">=</span><span class="mi">6</span><span class="x">,</span><span class="n">length</span><span class="o">=</span><span class="mi">128</span><span class="x">)</span>
<span class="n">y_plot</span> <span class="o">=</span> <span class="n">σ</span><span class="x">(</span><span class="n">x_plot</span><span class="x">,</span> <span class="x">[</span><span class="mi">1</span><span class="x">,</span> <span class="mi">1</span><span class="x">])</span>

<span class="n">n</span> <span class="o">=</span> <span class="mi">32</span>
<span class="n">xdata</span> <span class="o">=</span> <span class="n">range</span><span class="x">(</span><span class="o">-</span><span class="mi">6</span><span class="x">,</span><span class="n">stop</span><span class="o">=</span><span class="mi">6</span><span class="x">,</span><span class="n">length</span><span class="o">=</span><span class="n">n</span><span class="x">)</span>
<span class="n">ydata</span> <span class="o">=</span> <span class="n">σ</span><span class="x">(</span><span class="n">xdata</span><span class="x">,</span> <span class="x">[</span><span class="mi">1</span> <span class="mi">1</span><span class="x">])</span> <span class="o">+</span> <span class="mf">0.05</span><span class="o">*</span><span class="n">randn</span><span class="x">(</span><span class="n">n</span><span class="x">)</span>

<span class="n">anim</span> <span class="o">=</span> <span class="nd">@animate</span> <span class="k">for</span> <span class="n">i</span> <span class="k">in</span> <span class="mi">2</span><span class="o">:</span><span class="n">n</span>
    <span class="n">θ_est</span> <span class="o">=</span> <span class="n">coef</span><span class="x">(</span><span class="n">curve_fit</span><span class="x">(</span><span class="n">σ</span><span class="x">,</span> <span class="n">xdata</span><span class="x">[</span><span class="mi">1</span><span class="o">:</span><span class="n">i</span><span class="x">],</span> <span class="n">ydata</span><span class="x">[</span><span class="mi">1</span><span class="o">:</span><span class="n">i</span><span class="x">],</span> <span class="x">[</span><span class="mf">1.0</span><span class="x">,</span> <span class="mf">1.0</span><span class="x">]))</span>
    
    <span class="n">plot</span><span class="x">(</span><span class="n">x_plot</span><span class="x">,</span> <span class="n">y_plot</span><span class="x">,</span> <span class="n">label</span><span class="o">=</span><span class="s">"True"</span><span class="x">,</span> <span class="n">legend</span><span class="o">=:</span><span class="n">bottomright</span><span class="x">,</span> <span class="n">ylims</span><span class="o">=</span><span class="x">(</span><span class="o">-</span><span class="mf">0.25</span><span class="x">,</span> <span class="mf">1.25</span><span class="x">),</span> <span class="n">w</span><span class="o">=</span><span class="mi">3</span><span class="x">)</span>
    <span class="n">scatter!</span><span class="x">(</span><span class="n">xdata</span><span class="x">[</span><span class="mi">1</span><span class="o">:</span><span class="n">i</span><span class="x">],</span> <span class="n">ydata</span><span class="x">[</span><span class="mi">1</span><span class="o">:</span><span class="n">i</span><span class="x">],</span> <span class="n">label</span><span class="o">=</span><span class="s">""</span><span class="x">,</span> <span class="n">ms</span> <span class="o">=</span> <span class="mi">5</span><span class="x">)</span>
    <span class="n">scatter!</span><span class="x">(</span><span class="n">xdata</span><span class="x">[</span><span class="n">i</span><span class="o">+</span><span class="mi">1</span><span class="o">:</span><span class="k">end</span><span class="x">],</span> <span class="n">ydata</span><span class="x">[</span><span class="n">i</span><span class="o">+</span><span class="mi">1</span><span class="o">:</span><span class="k">end</span><span class="x">],</span> <span class="n">label</span><span class="o">=</span><span class="s">""</span><span class="x">,</span> <span class="n">mc</span> <span class="o">=</span> <span class="o">:</span><span class="n">lightgray</span><span class="x">,</span> <span class="n">ms</span> <span class="o">=</span> <span class="mi">5</span><span class="x">)</span>
    <span class="n">plot!</span><span class="x">(</span><span class="n">x_plot</span><span class="x">,</span> <span class="n">σ</span><span class="x">(</span><span class="n">x_plot</span><span class="x">,</span> <span class="n">θ_est</span><span class="x">)</span> <span class="x">,</span> <span class="n">label</span><span class="o">=</span><span class="s">"Estimated"</span><span class="x">,</span> <span class="n">w</span><span class="o">=</span><span class="mi">2</span><span class="x">)</span>
    <span class="n">vline!</span><span class="x">([</span><span class="n">xdata</span><span class="x">[</span><span class="n">i</span><span class="x">]],</span> <span class="n">label</span><span class="o">=</span><span class="s">""</span><span class="x">,</span> <span class="n">w</span><span class="o">=</span><span class="mi">2</span><span class="x">)</span>
<span class="k">end</span>
<span class="n">gif</span><span class="x">(</span><span class="n">anim</span><span class="x">,</span> <span class="s">"sigmoid_fit.gif"</span><span class="x">,</span> <span class="n">fps</span> <span class="o">=</span> <span class="mi">10</span><span class="x">)</span>
</code></pre></div></div>]]></content><author><name></name></author><category term="julia"/><category term="ssp"/><summary type="html"><![CDATA[A simple noise2self experimennt]]></summary></entry><entry><title type="html">Noise2self experiment 💻</title><link href="https://andferrari.github.io/blog/2021/noise2self/" rel="alternate" type="text/html" title="Noise2self experiment 💻"/><published>2021-09-09T00:00:00+00:00</published><updated>2021-09-09T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/noise2self</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/noise2self/"><![CDATA[<p>A simple <a href="https://arxiv.org/abs/1901.11365">noise2self</a> experimennt using a <a href="https://arxiv.org/abs/1608.03981">DCNN</a>. The julia code is <a href="https://github.com/andferrari/Noise2Self.jl">here</a>.</p> <p><img src="/assets/img/posts/noisy.png" alt="Noisy" width="300"/></p> <p><img src="/assets/img/posts/denoised.png" alt="Denoised" width="300"/></p>]]></content><author><name></name></author><category term="ml"/><summary type="html"><![CDATA[A simple noise2self experimennt]]></summary></entry><entry><title type="html">Waterfall plot 💻</title><link href="https://andferrari.github.io/blog/2021/waterfall/" rel="alternate" type="text/html" title="Waterfall plot 💻"/><published>2021-09-09T00:00:00+00:00</published><updated>2021-09-09T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/waterfall</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/waterfall/"><![CDATA[<p>Simple <a href="https://github.com/JuliaPlots/Plots.jl">Plots.jl</a> receipe for waterfall plots (a la <a href="https://gist.github.com/andferrari/3e254ffd67629078c1aaad95caf23079">Unknown Pleasures</a> 😀). Install using:</p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="n">pkg</span><span class="o">&gt;</span> <span class="n">add</span> <span class="n">https</span><span class="o">://</span><span class="n">github</span><span class="o">.</span><span class="n">com</span><span class="o">/</span><span class="n">andferrari</span><span class="o">/</span><span class="n">WaterFall</span><span class="o">.</span><span class="n">jl</span>
</code></pre></div></div> <p>and</p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">WaterFall</span>
<span class="n">x</span> <span class="o">=</span> <span class="x">[</span><span class="n">exp</span><span class="x">(</span><span class="o">-</span><span class="x">(</span><span class="n">n</span> <span class="o">-</span> <span class="mf">1e-2</span><span class="o">*</span><span class="n">τ</span><span class="o">^</span><span class="mi">2</span><span class="x">)</span><span class="o">^</span><span class="mi">2</span><span class="o">/</span><span class="n">τ</span><span class="x">)</span>  <span class="k">for</span> <span class="n">n</span> <span class="k">in</span> <span class="mi">0</span><span class="o">:</span><span class="mi">300</span><span class="x">,</span> <span class="n">τ</span> <span class="k">in</span> <span class="mi">40</span><span class="o">:</span><span class="mi">10</span><span class="o">:</span><span class="mi">160</span><span class="x">]</span>
<span class="n">plotfall</span><span class="x">(</span><span class="n">x</span><span class="x">,</span> <span class="n">w</span><span class="o">=</span><span class="mi">2</span><span class="x">)</span>
</code></pre></div></div>]]></content><author><name></name></author><category term="julia"/><summary type="html"><![CDATA[A simple waterfall julia plot]]></summary></entry><entry><title type="html">PrunedFFT 💻</title><link href="https://andferrari.github.io/blog/2021/prunedFFT/" rel="alternate" type="text/html" title="PrunedFFT 💻"/><published>2021-09-09T00:00:00+00:00</published><updated>2021-09-09T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/prunedFFT</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/prunedFFT/"><![CDATA[<p>You need to compute a <strong>subset</strong> of the outputs of a 2D FFT with a <strong>large zero padding</strong>? Try <a href="https://github.com/andferrari/PrunedFFT.jl">PrunedFFT.jl</a>. It works also on GPU🔥</p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">PrunedFFT</span>

<span class="n">n</span> <span class="o">=</span> <span class="mi">128</span>
<span class="n">x</span> <span class="o">=</span> <span class="n">rand</span><span class="x">(</span><span class="n">n</span><span class="x">,</span> <span class="n">n</span><span class="x">)</span>
<span class="n">n_pad</span> <span class="o">=</span> <span class="mi">1024</span>
<span class="n">k_span</span> <span class="o">=</span> <span class="n">collect</span><span class="x">(</span><span class="mi">512</span><span class="o">:</span><span class="mi">612</span><span class="x">)</span>

<span class="n">f</span> <span class="o">=</span> <span class="n">pruned_fft</span><span class="x">(</span><span class="n">x</span><span class="x">,</span> <span class="n">n_pad</span><span class="x">,</span> <span class="n">k_span</span><span class="x">)</span>
</code></pre></div></div> <p>If <code class="language-plaintext highlighter-rouge">CUDA.jl</code> is installed</p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">CUDA</span>

<span class="n">xc</span> <span class="o">=</span> <span class="n">cu</span><span class="x">(</span><span class="n">x</span><span class="x">)</span>
<span class="n">f</span> <span class="o">=</span> <span class="n">pruned_fft</span><span class="x">(</span><span class="n">xc</span><span class="x">,</span> <span class="n">n_pad</span><span class="x">,</span> <span class="n">k_span</span><span class="x">)</span>
</code></pre></div></div> <p>For a very large zero padding, GPU🔥 acceleration is a must!</p> <div class="language-plaintext highlighter-rouge"><div class="highlight"><pre class="highlight"><code>julia&gt; @time f1 = pruned_fft(xc, n_pad^2, k_span);
 0.713510 seconds (78.25 k allocations: 1.792 GiB, 17.73% gc time)

julia&gt; @time f1 = pruned_fft(x, n_pad^2, k_span);
19.362908 seconds (2.25 k allocations: 9.985 GiB, 3.82% gc time)
</code></pre></div></div>]]></content><author><name></name></author><category term="julia"/><summary type="html"><![CDATA[Fast subset of a 2D FFT]]></summary></entry><entry><title type="html">Rainbow on Valrose 🦄</title><link href="https://andferrari.github.io/blog/2021/rainbow/" rel="alternate" type="text/html" title="Rainbow on Valrose 🦄"/><published>2021-09-09T00:00:00+00:00</published><updated>2021-09-09T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/rainbow</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/rainbow/"><![CDATA[<p><img src="/assets/img/posts/rainbow.jpeg" alt="rainbow" width="600"/></p>]]></content><author><name></name></author><category term="fun"/><summary type="html"><![CDATA[Rainbow on from the office]]></summary></entry><entry><title type="html">Convvergence rate with Pluto 🎈</title><link href="https://andferrari.github.io/blog/2021/cvx_speed/" rel="alternate" type="text/html" title="Convvergence rate with Pluto 🎈"/><published>2021-03-01T00:00:00+00:00</published><updated>2021-03-01T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/cvx_speed</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/cvx_speed/"><![CDATA[<p>Convergence rate vs Hessian condition number using a <a href="https://github.com/fonsp/Pluto.jl">Pluto.jl</a> notebook:</p> <p><img src="/assets/img/posts/conv.gif" alt="sigmoid_fit"/></p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">using</span> <span class="n">Plots</span><span class="x">,</span> <span class="n">LinearAlgebra</span><span class="x">,</span> <span class="n">PlutoUI</span>
</code></pre></div></div> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">begin</span>
  <span class="n">f</span><span class="x">(</span><span class="n">x</span><span class="x">)</span> <span class="o">=</span> <span class="n">x</span><span class="x">[</span><span class="mi">1</span><span class="x">]</span><span class="o">^</span><span class="mi">2</span> <span class="o">+</span> <span class="n">γ</span><span class="o">*</span><span class="n">x</span><span class="x">[</span><span class="mi">2</span><span class="x">]</span><span class="o">^</span><span class="mi">2</span>
  <span class="n">∇f</span><span class="x">(</span><span class="n">x</span><span class="x">)</span> <span class="o">=</span> <span class="x">[</span><span class="mi">2</span><span class="o">*</span><span class="n">x</span><span class="x">[</span><span class="mi">1</span><span class="x">],</span> <span class="mi">2</span><span class="o">*</span><span class="n">γ</span><span class="o">*</span><span class="n">x</span><span class="x">[</span><span class="mi">2</span><span class="x">]]</span>
  <span class="n">opt_step</span><span class="x">(</span><span class="n">x</span><span class="x">,</span> <span class="n">Δ</span><span class="x">)</span> <span class="o">=</span> <span class="o">-</span> <span class="x">(</span><span class="n">x</span><span class="x">[</span><span class="mi">1</span><span class="x">]</span><span class="o">*</span><span class="n">Δ</span><span class="x">[</span><span class="mi">1</span><span class="x">]</span> <span class="o">+</span> <span class="n">γ</span><span class="o">*</span><span class="n">x</span><span class="x">[</span><span class="mi">2</span><span class="x">]</span><span class="o">*</span><span class="n">Δ</span><span class="x">[</span><span class="mi">2</span><span class="x">])</span><span class="o">/</span><span class="x">(</span><span class="n">Δ</span><span class="x">[</span><span class="mi">1</span><span class="x">]</span><span class="o">^</span><span class="mi">2</span> <span class="o">+</span> <span class="n">γ</span><span class="o">*</span><span class="n">Δ</span><span class="x">[</span><span class="mi">2</span><span class="x">]</span><span class="o">^</span><span class="mi">2</span><span class="x">)</span>

  <span class="k">function</span><span class="nf"> grad_desc</span><span class="x">(;</span> <span class="n">n_itermax</span> <span class="o">=</span> <span class="mi">40</span><span class="x">,</span> <span class="n">x0</span> <span class="o">=</span> <span class="x">[</span><span class="mi">10</span><span class="x">,</span> <span class="mi">1</span><span class="x">],</span> <span class="n">ϵ</span> <span class="o">=</span> <span class="mf">1e-1</span><span class="x">)</span>
    <span class="n">x</span> <span class="o">=</span> <span class="n">zeros</span><span class="x">(</span><span class="mi">2</span><span class="x">,</span> <span class="n">n_itermax</span><span class="x">)</span>
    <span class="n">x</span><span class="x">[</span><span class="o">:</span><span class="x">,</span><span class="mi">1</span><span class="x">]</span> <span class="o">=</span> <span class="n">x0</span>
    <span class="n">k</span> <span class="o">=</span> <span class="mi">1</span>
    <span class="k">while</span> <span class="x">(</span><span class="n">norm</span><span class="x">(</span><span class="n">∇f</span><span class="x">(</span><span class="n">x</span><span class="x">[</span><span class="o">:</span><span class="x">,</span><span class="n">k</span><span class="x">]))</span> <span class="o">&gt;</span> <span class="n">ϵ</span><span class="x">)</span> <span class="o">&amp;&amp;</span> <span class="x">(</span><span class="n">k</span> <span class="o">&lt;</span> <span class="n">n_itermax</span><span class="x">)</span>
        <span class="n">Δ</span> <span class="o">=</span> <span class="o">-</span> <span class="n">∇f</span><span class="x">(</span><span class="n">x</span><span class="x">[</span><span class="o">:</span><span class="x">,</span><span class="n">k</span><span class="x">])</span>
        <span class="n">x</span><span class="x">[</span><span class="o">:</span><span class="x">,</span> <span class="n">k</span><span class="o">+</span><span class="mi">1</span><span class="x">]</span> <span class="o">=</span> <span class="n">x</span><span class="x">[</span><span class="o">:</span><span class="x">,</span> <span class="n">k</span><span class="x">]</span> <span class="o">+</span> <span class="n">opt_step</span><span class="x">(</span><span class="n">x</span><span class="x">[</span><span class="o">:</span><span class="x">,</span><span class="n">k</span><span class="x">],</span> <span class="n">Δ</span><span class="x">)</span><span class="o">*</span><span class="n">Δ</span>
        <span class="n">k</span> <span class="o">+=</span> <span class="mi">1</span>
    <span class="k">end</span>
    <span class="n">x</span><span class="x">,</span> <span class="n">k</span>
  <span class="k">end</span>
<span class="k">end</span>
</code></pre></div></div> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="nd">@bind</span> <span class="n">γ</span> <span class="n">Slider</span><span class="x">(</span><span class="mi">1</span><span class="o">:</span><span class="mf">0.1</span><span class="o">:</span><span class="mi">15</span><span class="x">,</span> <span class="n">default</span><span class="o">=</span><span class="mi">5</span><span class="x">)</span>
</code></pre></div></div> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">begin</span>	
<span class="n">x</span><span class="x">,</span> <span class="n">k_max</span> <span class="o">=</span> <span class="n">grad_desc</span><span class="x">()</span>
<span class="n">x1_</span><span class="x">,</span> <span class="n">x2_</span> <span class="o">=</span> <span class="kt">LinRange</span><span class="x">(</span><span class="o">-</span><span class="mi">10</span><span class="x">,</span> <span class="mi">10</span><span class="x">,</span> <span class="mi">64</span><span class="x">),</span> <span class="kt">LinRange</span><span class="x">(</span><span class="o">-</span><span class="mi">10</span><span class="x">,</span> <span class="mi">10</span><span class="x">,</span> <span class="mi">64</span><span class="x">)</span>
<span class="n">contour</span><span class="x">(</span><span class="n">x1_</span><span class="x">,</span> <span class="n">x2_</span><span class="x">,</span> <span class="x">(</span><span class="n">x</span><span class="x">,</span><span class="n">y</span><span class="x">)</span><span class="o">-&gt;</span><span class="n">f</span><span class="x">([</span><span class="n">x</span><span class="x">,</span> <span class="n">y</span><span class="x">]),</span> <span class="n">xl</span><span class="o">=</span><span class="s">"x₁"</span><span class="x">,</span> <span class="n">yl</span><span class="o">=</span> <span class="s">"x₂"</span><span class="x">,</span> <span class="n">rat</span><span class="o">=:</span><span class="n">equal</span><span class="x">,</span> <span class="n">cb</span><span class="o">=</span><span class="nb">false</span><span class="x">);</span>
<span class="n">plot!</span><span class="x">(</span><span class="n">x</span><span class="x">[</span><span class="mi">1</span><span class="x">,</span> <span class="mi">1</span><span class="o">:</span><span class="n">k_max</span><span class="x">],</span> <span class="n">x</span><span class="x">[</span><span class="mi">2</span><span class="x">,</span><span class="mi">1</span><span class="o">:</span><span class="n">k_max</span><span class="x">],</span> <span class="n">m</span><span class="o">=:</span><span class="n">circle</span><span class="x">,</span> <span class="n">label</span><span class="o">=</span><span class="s">""</span><span class="x">,</span> <span class="n">aspect_ratio</span><span class="o">=:</span><span class="n">equal</span><span class="x">,</span> <span class="n">size</span><span class="o">=</span><span class="x">(</span><span class="mi">400</span><span class="x">,</span><span class="mi">400</span><span class="x">))</span>
<span class="n">title!</span><span class="x">(</span><span class="s">"f(x) = x₁² + </span><span class="si">$</span><span class="s">γ.x₂²,  </span><span class="si">$</span><span class="s">(k_max-1) iterations"</span><span class="x">,</span> <span class="n">titlefontsize</span><span class="o">=</span><span class="mi">10</span><span class="x">)</span>
<span class="k">end</span>
</code></pre></div></div>]]></content><author><name></name></author><category term="teaching"/><summary type="html"><![CDATA[Convergence rate of minimization as a function of Hessian conditioning]]></summary></entry><entry><title type="html">DFT with Pluto 🎈</title><link href="https://andferrari.github.io/blog/2021/dft/" rel="alternate" type="text/html" title="DFT with Pluto 🎈"/><published>2021-03-01T00:00:00+00:00</published><updated>2021-03-01T00:00:00+00:00</updated><id>https://andferrari.github.io/blog/2021/dft</id><content type="html" xml:base="https://andferrari.github.io/blog/2021/dft/"><![CDATA[<p>Fourier transforms of $exp(j\omega_0 n)$ using a <a href="https://github.com/fonsp/Pluto.jl">Pluto.jl</a> notebook: <img src="/assets/img/posts/dft.gif" alt="sigmoid_fit" width="500"/></p> <p>The interactive notebook can be run on <a href="https://binder.plutojl.org/v0.19.12/open?url=https%253A%252F%252Fgist.githubusercontent.com%252Fandferrari%252F11a67e9211844f3ceea017042169b0b5%252Fraw%252F0256fb0a4679a17ce8b9589d9ce3b8be1203c40d%252Fdft.jl">binder</a>, but be patient 😴.</p> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">begin</span>
  <span class="k">using</span> <span class="n">Plots</span><span class="x">,</span> <span class="n">PlutoUI</span>

  <span class="k">function</span><span class="nf"> DFT_plot</span><span class="x">(</span><span class="n">ω₀</span><span class="x">,</span> <span class="n">N</span><span class="x">)</span>
    <span class="n">f</span><span class="x">(</span><span class="n">ω</span><span class="x">)</span> <span class="o">=</span> <span class="n">abs</span><span class="x">(</span><span class="n">sin</span><span class="x">(</span><span class="n">N</span><span class="o">*</span><span class="n">ω</span><span class="o">/</span><span class="mi">2</span><span class="x">)</span><span class="o">/</span><span class="n">sin</span><span class="x">(</span><span class="n">ω</span><span class="o">/</span><span class="mi">2</span><span class="x">))</span>
    <span class="n">ω_DFT</span> <span class="o">=</span> <span class="x">(</span><span class="mi">0</span><span class="o">:</span><span class="n">N</span><span class="o">-</span><span class="mi">1</span><span class="x">)</span><span class="o">*</span><span class="mi">2</span><span class="nb">π</span><span class="o">/</span><span class="n">N</span>
    <span class="n">plot</span><span class="x">(</span><span class="n">ω</span> <span class="o">-&gt;</span> <span class="n">f</span><span class="x">(</span><span class="n">ω</span> <span class="o">-</span> <span class="n">ω₀</span><span class="x">),</span> <span class="mi">0</span><span class="x">,</span> <span class="mi">2</span><span class="nb">π</span><span class="x">,</span> <span class="n">label</span><span class="o">=</span><span class="s">"Fourier transform"</span><span class="x">,</span> <span class="n">xlabel</span><span class="o">=</span><span class="s">"ω"</span><span class="x">,</span> <span class="n">w</span><span class="o">=</span><span class="mi">2</span><span class="x">)</span>
    <span class="n">plot!</span><span class="x">(</span><span class="n">ω_DFT</span><span class="x">,</span> <span class="n">f</span><span class="o">.</span><span class="x">(</span><span class="n">ω_DFT</span> <span class="o">.-</span> <span class="n">ω₀</span><span class="x">),</span> <span class="n">line</span> <span class="o">=</span> <span class="o">:</span><span class="n">stem</span><span class="x">,</span> 
      <span class="n">label</span><span class="o">=</span><span class="s">"Discrete Fourier Transform"</span><span class="x">,</span> <span class="n">marker</span> <span class="o">=</span> <span class="o">:</span><span class="n">circle</span><span class="x">,</span> <span class="n">w</span><span class="o">=</span><span class="mi">2</span><span class="x">)</span>
    <span class="n">vline!</span><span class="x">([</span><span class="n">ω₀</span><span class="x">],</span> <span class="n">label</span><span class="o">=</span><span class="s">"ω₀ = </span><span class="si">$</span><span class="s">(round(ω₀, digits=2))"</span><span class="x">,</span> <span class="n">w</span><span class="o">=</span><span class="mi">3</span><span class="x">)</span>
    <span class="n">title!</span><span class="x">(</span><span class="s">"Fourier transforms of x(n)=exp(jω₀n), n=1…</span><span class="si">$</span><span class="s">N"</span><span class="x">)</span>
  <span class="k">end</span>
<span class="k">end</span>
</code></pre></div></div> <div class="language-julia highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="k">begin</span>
